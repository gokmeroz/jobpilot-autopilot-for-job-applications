#!/usr/bin/env bash
# JobPilot CLI launcher — runs main.py with the project's venv from any directory.
# Install: make install-cli  (symlinks this into ~/.local/bin)
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
exec "$ROOT/.venv/bin/python" "$ROOT/main.py" "$@"
